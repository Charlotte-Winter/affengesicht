// Erste Zeile muss ein Kommentar sein!
try {
  let { Services } = Cu.import("resource://gre/modules/Services.jsm", {});
  let windows = Services.wm.getEnumerator("navigator:browser");
  
  while (windows.hasMoreElements()) {
    let win = windows.getNext();
    win.addEventListener("load", () => {
      let doc = win.document;
      let navbar = doc.getElementById("nav-bar");
      if (navbar && !doc.getElementById("navbar-clock")) {
        let clock = doc.createElement("span");
        clock.id = "navbar-clock";
        
        let updateTime = () => clock.textContent = new Date().toLocaleTimeString();
        updateTime();
        win.setInterval(updateTime, 1000);
        
        navbar.appendChild(clock);
      }
    }, { once: true });
  }
} catch (e) {}
