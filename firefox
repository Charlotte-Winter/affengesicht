// ==UserScript==
// @name          Test Sidebar Widget
// @description   Fügt ein simples Widget hinzu
// ==UserScript==

(function() {
  function init() {
    let doc = window.document;
    let sidebarContainer = doc.getElementById("sidebar-container");

    if (sidebarContainer && !doc.getElementById("my-custom-widget")) {
      let lbl = doc.createElement("label");
      lbl.id = "my-custom-widget";
      lbl.textContent = "Widget";
      sidebarContainer.appendChild(lbl);
    }
  }

  if (document.readyState === "complete") {
    init();
  } else {
    window.addEventListener("DOMContentLoaded", init, { once: true });
  }
})();

