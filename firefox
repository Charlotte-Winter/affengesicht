try {
    const { Services } = ChromeUtils.import("resource://gre/modules/Services.jsm");

    function handleWindow(win) {
        win.addEventListener("DOMContentLoaded", () => {
            if (win.location.href === "chrome://browser/content/browser.xhtml") {
                let doc = win.document;
                let navBar = doc.getElementById("nav-bar");
                // Prüfen, ob das Widget nicht doppelt eingefügt wird
                if (navBar && !doc.getElementById("my-custom-widget")) {
                    let lbl = doc.createElement("label");
                    lbl.id = "my-custom-widget";
                    lbl.textContent = "Widget";
                    lbl.style.color = "red";
                    lbl.style.fontWeight = "bold";
                    lbl.style.padding = "0 8px";
                    navBar.appendChild(lbl);
                }
            }
        }, { once: true });
    }

    // Auf neue Firefox-Fenster lauschen
    Services.ww.registerNotification({
        observe: function(subject, topic, data) {
            if (topic === "domwindowopened") {
                handleWindow(subject);
            }
        }
    });

    let windows = Services.wm.getEnumerator("navigator:browser");
    while (windows.hasMoreElements()) {
        handleWindow(windows.getNext());
    }
} catch (e) {
    Cu.reportError(e);
}
