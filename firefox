try {
  let { Services } = Components.utils.import("resource://gre/modules/Services.jsm", {});

  function loadUCJS() {
    try {
      let cfxDir = Services.dirsvc.get("UChrm", Components.interfaces.nsIFile);
      cfxDir.append("JS");
      
      if (cfxDir.exists() && cfxDir.isDirectory()) {
        let files = cfxDir.directoryEntries;
        while (files.hasMoreElements()) {
          let file = files.getNext().QueryInterface(Components.interfaces.nsIFile);
          if (file.isFile() && file.leafName.endsWith(".uc.js")) {
            let fileURI = Services.io.newFileURI(file).spec;
            Services.scriptloader.loadSubScript(fileURI, globalThis);
          }
        }
      }
    } catch (err) {
      Components.utils.reportError(err);
    }
  }

  Services.obs.addObserver(function(subject, topic) {
    if (topic === "chrome-document-global-created") {
      let win = subject;
      win.addEventListener("DOMContentLoaded", function() {
        if (win.location.href === "chrome://browser/content/browser.xhtml") {
          loadUCJS();
        }
      }, { once: true });
    }
  }, "chrome-document-global-created");

} catch (e) {
  Components.utils.reportError(e);
}
