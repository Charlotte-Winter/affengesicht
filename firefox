(function() {
  let navBar = document.getElementById("nav-bar");
  let urlbarContainer = document.getElementById("urlbar-container");
  if (!navBar || !urlbarContainer) return;

  let clockWidget = document.createElement("toolbaritem");
  clockWidget.id = "native-clock-widget";

  let clockLabel = document.createElement("span");
  clockWidget.appendChild(clockLabel);

  urlbarContainer.parentNode.insertBefore(clockWidget, urlbarContainer);

  function updateClock() {
    let now = new Date();
    clockLabel.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit'});
  }

  setInterval(updateClock, 1000);
  updateClock();

  let netWidget = document.createElement("toolbaritem");
  netWidget.id = "native-net-widget";

  let netLabel = document.createElement("span");
  netWidget.appendCHild(netLabel);

  urlbarContainer.parentNode.insertBefore(netWidget, urlbarContainer.nextSibling);

  let lastBytes = 0;
  let lastTime = performance.now();

  function updateNetSpeed() {
    let entries = performance.getEntriesByType("resource");
    let totalBytes = 0;

    for (let entry of entries) {
      if (entry.transferSize) totalBytes += entry.transferSize;
    }

    let currentTime = performance.now();
    let timeDiff = (currentTime - lastTime) / 1000;
    if (timeDiff > 0 && lastBytes > 0) {
      let speedBps = (totalBytes - lastBytes) / timeDiff;
      if (speedBps < 0) speedBps = 0;

      let speedKbps = (speedBps / 1024).toFixed(1);
      netLabel.textContent = `down ${speedKbps} KB/s`;
    } else {
      netLabel.textContent = `down 0.0 KB/s`;
    }

    lastBytes = totalBytes;
    lastTime = currentTime;
  }

  setInterval(updateNetSpeed, 1000);
})();

