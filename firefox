// First line must be a comment
try {
  let { Services } = Cu.import("resource://gre/modules/Services.jsm", {});
  
  Services.obs.addObserver({
    observe: function(aSubject, aTopic, aData) {
      let win = aSubject;
      win.addEventListener("DOMContentLoaded", function() {
        if (win.location.href === "chrome://browser/content/browser.xhtml") {
          // Create the clock element
          let clock = win.document.createElement("label");
          clock.id = "custom-tabbar-clock";
          clock.style.padding = "0 10px";
          clock.style.alignSelf = "center";
          clock.style.fontFamily = "monospace";
          clock.style.fontSize = "12px";

          // Place it in the tab bar
          let tabBox = win.document.getElementById("TabsToolbar");
          if (tabBox) {
            tabBox.appendChild(clock);
          }

          // Update time every second
          function updateClock() {
            let now = new Date();
            clock.value = now.toLocaleTimeString();
          }

          updateClock();
          win.setInterval(updateClock, 1000);
        }
      }, { once: true });
    }
  }, "domwindowopened", false);
} catch(e) {
  // Silence errors on startup
}
