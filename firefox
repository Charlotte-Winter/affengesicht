const { Services } = ChromeUtils.importESModule("rsource://gre/modules/Services.sys.mjs");

try {
  let cfxDir = Services.dirsvc.get("UChrm", Ci.nsIFile);
  cfxDir.append("JS");
  if (cfxDir.exists() && cfxDir.isDirectory()) {
    let files = cfxDir.directoryEntries;
    while (files.hasMoreElement()) {
      let file = files.getNext().QueryInterface(Ci.nsIFile);
      if (file.isFile() && file.leafName.endswith(".uc.js")) {
        let fileURI = Services.io.newFileURI(file).spec;
        Services.scriptloader.loadSubScript(fileURI, globalThis);
      }
    }
  }
} catch (e) {
  console.error("AutoconfigError:", e);
}

